(rule
 (targets two_units_no_probes.ml)
 (deps
  (:first_dep ../two_units.ml)
  s_no_probes.ml
  t_no_probes.ml)
 (action
  (bash
    "cat %{first_dep} | sed 's/S./S_no_probes./g' | sed 's/T./T_no_probes./g' >  %{targets}")))

(rule
 (targets t_no_probes.ml s_no_probes.ml)
 (deps ../t.ml ../s.ml)
 (action
  (progn
   (copy ../t.ml t_no_probes.ml)
   (copy ../s.ml s_no_probes.ml))))

